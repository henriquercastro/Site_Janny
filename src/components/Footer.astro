---
import site from '../data/site.json';
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <a class="brand" href="/" style="color:white">{site.brandName}<small>{site.tagline}</small></a>
      <nav class="footer-nav"><a href="/sobre">Sobre</a><a href="/publicacoes">Publicações</a><a href="/eventos">Eventos</a><a href="/podcasts">Podcast</a><a href="/#contato">Contato</a></nav>
    </div>
    <div class="footer-bottom"><span>© {new Date().getFullYear()} {site.brandName}. Todos os direitos reservados.</span><span>{site.footerLine}</span></div>
  </div>
</footer>
