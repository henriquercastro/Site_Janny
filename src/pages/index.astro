---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentCard from '../components/ContentCard.astro';
import { getCollection } from 'astro:content';
import home from '../data/home.json';
import site from '../data/site.json';

const publications = (await getCollection('publicacoes')).filter(i => !i.data.draft);
const events = (await getCollection('eventos')).filter(i => !i.data.draft);
const podcasts = (await getCollection('podcasts')).filter(i => !i.data.draft);

const publicationDate = (item) => item.data.date ? item.data.date.getTime() : (item.data.year ? new Date(item.data.year, 0, 1).getTime() : 0);
const recentPublications = [...publications].sort((a,b) => publicationDate(b) - publicationDate(a)).slice(0,4);
const featuredPublication = publications.find(i => i.data.featured) || recentPublications[0];
const featuredEvent = events.find(i => i.data.featured) || events[0];
const featuredPodcast = podcasts.find(i => i.data.featured) || podcasts[0];
---
<BaseLayout title="Janny Castro — Financial Services, Compliance, Riscos e ESG">
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-copy">
        <p class="eyebrow" style="color:#dac798">{home.heroEyebrow}</p>
        <h1 class="display">{home.heroTitle}</h1>
        <div class="hero-role">{home.heroRole}</div>
        <p class="lead">{home.heroText}</p>
        <div class="hero-actions"><a class="btn btn-primary" href="/sobre">Conheça minha trajetória →</a><a class="btn btn-outline" href="#conteudos">Ver conteúdos ↗</a></div>
      </div>
      <div class="hero-photo"><img src={home.heroImage} alt="Janny Castro" /><div class="hero-quote">“{home.heroQuote}”</div></div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="trajectory-grid">
        <div class="trajectory-copy">
          <p class="eyebrow">Trajetória</p>
          <h2 class="section-title">{home.trajectoryTitle}</h2>
          <p>{home.trajectoryText1}</p>
          <p>{home.trajectoryText2}</p>
          <a class="text-link" href="/sobre">Saiba mais sobre minha trajetória →</a>
        </div>
        <div class="credentials">
          <div class="credential"><strong>30+</strong><span>anos de experiência no mercado financeiro</span></div>
          <div class="credential"><strong>360°</strong><span>visão construída da operação à governança</span></div>
          <div class="credential"><strong>Autora</strong><span>livros, artigos e produção de conhecimento</span></div>
          <div class="credential"><strong>Professora</strong><span>formação e compartilhamento de experiência</span></div>
        </div>
      </div>
      <div class="expertise">
        <div class="expertise-item">Compliance Regulatório</div><div class="expertise-item">Riscos & Controles</div><div class="expertise-item">ESG</div><div class="expertise-item">Governança</div><div class="expertise-item">Mercado Financeiro</div><div class="expertise-item">PLD/FT & Integridade</div>
      </div>
    </div>
  </section>

  <section class="section" id="conteudos">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Destaques</p><h2 class="section-title">Ideias, análises e conversas que conectam mercado e regulação</h2></div><a class="text-link" href="/publicacoes">Ver todos os conteúdos →</a></div>
      <div class="cards">
        {featuredPublication && <ContentCard kicker={featuredPublication.data.type || featuredPublication.data.category || 'Publicação'} title={featuredPublication.data.title} meta={[featuredPublication.data.vehicle, featuredPublication.data.year].filter(Boolean).join(' • ')} image={featuredPublication.data.cover} href={featuredPublication.data.externalUrl || `/publicacoes/${featuredPublication.id}`} external={!!featuredPublication.data.externalUrl} />}
        {featuredEvent && <ContentCard kicker={featuredEvent.data.theme || 'Evento'} title={featuredEvent.data.title} meta={[featuredEvent.data.institution, featuredEvent.data.city].filter(Boolean).join(' • ')} image={featuredEvent.data.cover} href={`/eventos/${featuredEvent.id}`} />}
        {featuredPodcast && <ContentCard kicker={featuredPodcast.data.episodeNumber ? `Episódio #${featuredPodcast.data.episodeNumber}` : 'Podcast'} title={featuredPodcast.data.title} meta={featuredPodcast.data.guests} image={featuredPodcast.data.cover} href={featuredPodcast.data.spotifyUrl} external={true} />}
      </div>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Publicações recentes</p><h2 class="section-title">Leituras para acompanhar as mudanças do setor</h2></div><a class="text-link" href="/publicacoes">Todas as publicações →</a></div>
      <div class="publication-grid">
        {recentPublications.map(item => <ContentCard kicker={item.data.type || item.data.category || 'Publicação'} title={item.data.title} meta={[item.data.vehicle, item.data.year].filter(Boolean).join(' • ')} image={item.data.cover} href={item.data.externalUrl || `/publicacoes/${item.id}`} external={!!item.data.externalUrl} />)}
      </div>
    </div>
  </section>

  <section class="section events-band">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Eventos e palestras</p><h2 class="section-title">Conhecimento em diálogo com o mercado</h2></div><a class="text-link" href="/eventos">Ver participações →</a></div>
      <div class="cards">
        {events.slice(0,3).map(item => <ContentCard kicker={item.data.theme || 'Evento'} title={item.data.title} meta={[item.data.institution,item.data.city].filter(Boolean).join(' • ')} image={item.data.cover} href={`/eventos/${item.id}`} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head"><div><p class="eyebrow">Sala de Negócios</p><h2 class="section-title">Conversas sobre negócios, riscos e mercado</h2></div><a class="text-link" href="/podcasts">Todos os episódios →</a></div>
      <div class="cards">
        {podcasts.slice(0,3).map(item => <ContentCard kicker={item.data.episodeNumber ? `Episódio #${item.data.episodeNumber}` : 'Podcast'} title={item.data.title} meta={item.data.guests} image={item.data.cover} href={item.data.spotifyUrl} external={true} />)}
      </div>
    </div>
  </section>

  <section class="about-strip">
    <div class="about-photo"><img src={home.aboutImage} alt="Janny Castro" /></div>
    <div class="about-copy"><p class="eyebrow">Mercado e academia</p><h2 class="section-title">{home.aboutTitle}</h2><p>{home.aboutText}</p><a class="text-link" href="/sobre">Conheça a trajetória completa →</a></div>
  </section>

  <section class="contact" id="contato">
    <div class="container contact-grid"><div><p class="eyebrow">Contato</p><h2 class="section-title">{home.contactTitle}</h2><p style="color:#59616a">{home.contactText}</p></div><div class="contact-links"><a class="btn btn-dark" href={`mailto:${site.email}`}>E-mail</a><a class="btn" style="border:1px solid var(--line)" href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a></div></div>
  </section>
</BaseLayout>
