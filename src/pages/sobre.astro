---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/sobre.json';
---
<BaseLayout title="Sobre — Janny Castro" description="Trajetória profissional de Janny Castro no mercado financeiro, compliance, riscos, governança e ESG.">
  <section class="page-hero"><div class="container"><p class="eyebrow">{page.eyebrow}</p><h1 class="display">{page.title}</h1><p>{page.intro}</p></div></section>
  <section class="section"><div class="container"><div class="prose"><p>{page.paragraph1}</p><p>{page.paragraph2}</p><h2>{page.section1Title}</h2><p>{page.section1Paragraph1}</p><p>{page.section1Paragraph2}</p><h2>{page.section2Title}</h2><p>{page.section2Paragraph1}</p><p>{page.section2Paragraph2}</p></div></div></section>
</BaseLayout>
